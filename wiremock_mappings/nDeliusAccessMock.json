{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathPattern": "/user/.*/access"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"access\": [{{#each (jsonPath request.body '$[*]') as |crn|}}{{#unless @first}},{{/unless}}{\"crn\": \"{{crn}}\", \"userExcluded\": {{#if (matches request.pathSegments.[1] 'AUTH_ADM|REFER_MONITOR_PP')}}{{#if (matches crn 'SX.*|.*[12]')}}true{{else}}false{{/if}}{{else}}false{{/if}}, \"userRestricted\": false}{{/each}}]}",
        "transformers": ["response-template"]
      }
    }
  ]
}
