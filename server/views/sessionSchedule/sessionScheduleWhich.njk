{% extends "../partials/layout.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageTitle = pageTitle + " - " + applicationName %}
{% set mainClasses = "app-container govuk-body" %}

{% block main %}
    {% block content %}
      <div class="govuk-width-container">
          <main class="govuk-main-wrapper" id="main-content">
                <div class="govuk-grid-row govuk-!-margin-bottom-6">
                  <div class="govuk-grid-column-two-thirds">
                    {{ govukBackLink(backLinkArgs) }}
                  </div>
                </div>
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-two-thirds">
                        {% if errorSummary !== null %}
                            {{ govukErrorSummary(errorSummary) }}
                        {% endif %}
                        <span class="govuk-caption-l">{{ text.headingHintText }}</span>
                        <form method="post" novalidate>
                            <input type="hidden" name="_csrf" value="{{csrfToken}}">
                                                        {% set sessionTemplateItems = [] %}
                                                        {% for template in sessionTemplates %}
                                                            {% set sessionTemplateValue = template.id + "+" + template.sessionScheduleType + "+" + template.name + "+" + template.sessionType %}
                                                                {% set sessionTypeHtml %}
                                                                    {{ govukRadios({
                                                                        name: "session-schedule-type-" + template.id,
                                                                        fieldset: {
                                                                            legend: {
                                                                                text: "Session type",
                                                                                classes: "govuk-fieldset__legend--s"
                                                                            }
                                                                        },
                                                                        errorMessage: { text: sessionScheduleTypeErrorMessage } if sessionScheduleTypeErrorMessage and selectedSession == sessionTemplateValue,
                                                                        items: [
                                                                            {
                                                                                id: "session-schedule-type-main-" + template.id,
                                                                                value: "SCHEDULED",
                                                                                text: "Main group session" if template.sessionType == "GROUP" else "One-to-one",
                                                                                checked: selectedSession == sessionTemplateValue and selectedSessionScheduleType == "SCHEDULED"
                                                                            },
                                                                            {
                                                                                id: "session-schedule-type-catch-up-" + template.id,
                                                                                value: "CATCH_UP",
                                                                                text: "Catch-up" if template.sessionType == "GROUP" else "One-to-one catch-up",
                                                                                checked: selectedSession == sessionTemplateValue and selectedSessionScheduleType == "CATCH_UP"
                                                                            }
                                                                        ]
                                                                    }) }}
                                                                {% endset -%}
                                                                {% set _ = sessionTemplateItems.push({
                                                                    value: sessionTemplateValue,
                                                                    text: template.name,
                                                                    checked: selectedSession == sessionTemplateValue,
                                                                    conditional: { html: sessionTypeHtml }
                                                                }) %}
                                                        {% endfor %}
                                                        {{ govukRadios({
                                                            name: "session-template",
                                                            fieldset: {
                                                                legend: {
                                                                    text: "Which session are you scheduling?",
                                                                    isPageHeading: true,
                                                                    classes: "govuk-fieldset__legend--l"
                                                                }
                                                            },
                                                            items: sessionTemplateItems,
                                                            errorMessage: sessionTemplateErrorMessage
                                                        }) }}
                            {{ govukButton({ text: "Continue", preventDoubleClick: true }) }}
                        </form>
                    </div>
                </div>
            </main>
        </div>
    {% endblock %}
{% endblock %}
