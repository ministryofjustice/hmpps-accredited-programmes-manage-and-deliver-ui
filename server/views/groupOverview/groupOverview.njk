{% extends "../partials/layout.njk" %}

{%- from "moj/components/filter/macro.njk" import mojFilter -%}
{%- from "govuk/components/input/macro.njk" import govukInput -%}
{%- from "govuk/components/table/macro.njk" import govukTable -%}
{% from "moj/components/sub-navigation/macro.njk" import mojSubNavigation %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{%- from "moj/components/alert/macro.njk" import mojAlert -%}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "../components/collapsible-checkbox-filter/macro.njk" import collapsibleCheckboxFilter %}


{% set pageTitle = pageTitle + " - " + applicationName %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full group-sub-nav">
    {{ mojSubNavigation(serviceNavigationArgs) }}
    <span class="govuk-caption-xl">{{ text.pageSubHeading }}</span>
    <h1 class="govuk-heading-xl">{{ text.pageHeading }}</h1>
  </div>

</div>

<div id="filter-top" tabindex="-1"></div>
<div class="govuk-grid-row">
  {%- set filterOptionsHtml %}
  <a class="clear-filters__link" href="{{ '?clearFilters=true' if isWaitlist else '?' }}">Clear filters</a>
  {{ govukInput(searchByCrnOrPersonNameArgs) }}
  {% if isWaitlist %}
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    {{ collapsibleCheckboxFilter(searchByCohortArgs) }}
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    {{ collapsibleCheckboxFilter(searchBySexArgs) }}
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
    {{ collapsibleCheckboxFilter(pduCheckboxArgs) }}

    {% if not presenter.showReportingTeams %}
      <h3 class="govuk-heading-s govuk-!-margin-bottom-1 govuk-!-margin-top-6">Reporting team</h3>
      <p class="govuk-body">Select one or more PDUs and apply filters to see reporting teams</p>
    {% endif %}

    {% if presenter.showReportingTeams %}
      {{ collapsibleCheckboxFilter(reportingTeamCheckboxArgs) }}
    {% endif %}
    <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">
  {% endif %}

  {{ govukButton(applyFilterButtonArgs) }}
    <a class="clear-filters__link" href="{{ '?clearFilters=true' if isWaitlist else '?' }}">Clear filters</a>
  {% endset -%}
  <div class="govuk-grid-column-one-quarter group-filter-column">
    <form id="filter-form" method="get" action="#filter-top" data-filter-form>
      {{ mojFilter({
      heading: {
      text: "Filter"
      },

      submit: {
      attributes: {
      "data-test-id": "submit-button"
      }
      },


      optionsHtml: filterOptionsHtml
      }) }}
    </form>
  </div>
  <div class="govuk-grid-column-three-quarters group-results-column">
    {% if errorSummary !== null %}
      {{ govukErrorSummary(errorSummary) }}
    {% endif %}

    {% if successMessageArgs !== null %}
      {{ mojAlert(successMessageArgs) }}
    {% endif %}

    {{ mojSubNavigation(subNavArgs) }}
 {% if resultsText %}
        <p class="govuk-body showing-results" role="status" aria-live="polite" aria-atomic="true">{{ resultsText | safe }}</p>
      {% endif %}
    <form method="post">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div id="add-to-group"></div>
      {% if hasResults %}
        <fieldset class="govuk-fieldset">
          <legend class="govuk-fieldset__legend govuk-visually-hidden">{{ presenter.selectionLegendText }}</legend>
          {{ govukTable(getGroupAllocationsTableArgs) }}
          {{ govukButton(formButtonArgs) }}
        </fieldset>
      {% else %}
        <p class="govuk-body-l">{{ noResultsString }}</p>
      {% endif %}
    </form>
     {% include "../partials/pagination.njk" %}
  </div>
</div>

  {% endblock %}

