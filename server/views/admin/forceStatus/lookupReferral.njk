{% extends "../../partials/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageTitle = pageTitle + " - " + applicationName %}
{% set mainClasses = "app-container govuk-body" %}

{% block main %}
    {% block content %}
        <main class="govuk-main-wrapper" id="main-content">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    {% if errorSummary !== null %}
                        {{ govukErrorSummary(errorSummary) }}
                    {% endif %}
                    <h1 class="govuk-heading-l">Force-update referral status</h1>
                    <p class="govuk-body">This tool sets a referral's status directly, bypassing the normal transition rules. Use it to correct a referral that has drifted out of sync with nDelius.</p>
                    <form method="post" novalidate>
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">
                        {{ govukInput(referralIdInputArgs) }}
                        {{ govukButton({ text: "Continue", preventDoubleClick: true }) }}
                    </form>
                </div>
            </div>
        </main>
    {% endblock %}
{% endblock %}
